# ---- 本地配置（含数据库口令，不入库）----
application-local.yml
application-local.properties

# run-etl-cluster.sh 会把配置同步到工作目录供 Driver 读取
/spark-job.properties

# 交付包输出目录（package-dist.ps1 生成）
/dist/

# 真实数据集（Olist）原始文件与转换产物，均可由脚本重新下载/生成
/data/real-raw/
/data/real/

# 演示脚本输出日志
/logs/
